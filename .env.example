# Bearabull Environment Configuration Example
APP_PORT=8080
APP_ENV=development
DATABASE_PATH=./bearabull.db
YAHOO_FINANCE_ENABLED=true
MARKET_DATA_REFRESH_INTERVAL=6h
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=15s
CACHE_TTL=15m
ANALYSIS_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
ADMIN_AUTH_ENABLED=false
ADMIN_API_KEY=bearabull-secret-key
STRATEGY_VERSION=v1.0.0
